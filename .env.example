# ===== 基本 =====
# PostgreSQL 接続文字列
DATABASE_URL=postgresql://sns:sns@localhost:5432/ai_sns_manager
# Redis 接続文字列（BullMQ のジョブキュー）
REDIS_URL=redis://localhost:6379

# Auth.js のセッション署名キー（生成: openssl rand -base64 32）
AUTH_SECRET=
# ローカル以外で動かす場合のみ設定（例: https://example.com）
AUTH_URL=http://localhost:3000
# リバースプロキシ配下（Render等）で動かす場合は true
AUTH_TRUST_HOST=true

# OAuth トークン暗号化キー。32バイトを base64 で（生成: openssl rand -base64 32）
ENCRYPTION_KEY=

# ===== SNS =====
# mock: 実際のSNS APIを呼ばない（開発・テスト用） / live: 登録したAPIキーで実際に投稿する
SOCIAL_PROVIDER_MODE=mock
# Mock Mode で投稿が確率的に一時失敗する割合（0〜1）。リトライ動作の確認用
MOCK_TRANSIENT_FAILURE_RATE=0

# 各SNSのAPIキーは .env ではなく、アプリの「SNSアカウント」画面からアカウントごとに登録する（暗号化して保存）。
# Meta Graph API のバージョン指定（任意。空ならアプリの既定バージョン）
THREADS_API_VERSION=
INSTAGRAM_API_VERSION=

# ===== AI =====
# Claude（Anthropic）の APIキー。AI 投稿生成（Phase 2）で使用する
ANTHROPIC_API_KEY=
# 画像・動画生成（Phase 3）
FAL_KEY=

# ===== テスト =====
# 設定すると DB を使う統合テストが実行される（未設定ならスキップ）。開発用DBとは別にすること
TEST_DATABASE_URL=
