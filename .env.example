# ===== 基本 =====
# PostgreSQL 接続文字列
DATABASE_URL=postgresql://sns:sns@localhost:5432/ai_sns_manager
# Redis 接続文字列（BullMQ のジョブキュー）
REDIS_URL=redis://localhost:6379

# Auth.js のセッション署名キー（生成: openssl rand -base64 32）
AUTH_SECRET=
# ローカル以外で動かす場合のみ設定（例: https://example.com）
AUTH_URL=http://localhost:3000
# リバースプロキシ配下（Render等）で動かす場合は true
AUTH_TRUST_HOST=true

# OAuth トークン暗号化キー。32バイトを base64 で（生成: openssl rand -base64 32）
ENCRYPTION_KEY=

# ===== SNS =====
# mock: 実際のSNS APIを呼ばない（開発・テスト用） / live: 登録したAPIキーで実際に投稿する
SOCIAL_PROVIDER_MODE=mock
# Mock Mode で投稿が確率的に一時失敗する割合（0〜1）。リトライ動作の確認用
MOCK_TRANSIENT_FAILURE_RATE=0

# 各SNSのAPIキーは .env ではなく、アプリの「SNSアカウント」画面からアカウントごとに登録する（暗号化して保存）。
# Meta Graph API のバージョン指定（任意。空ならアプリの既定バージョン）
THREADS_API_VERSION=
INSTAGRAM_API_VERSION=

# ===== AI =====
# Claude（Anthropic）の APIキー。AI 投稿生成で使用する
ANTHROPIC_API_KEY=
# 使用するモデル（空なら claude-sonnet-5-5）
ANTHROPIC_MODEL=
# 考える深さ low / medium / high（空なら medium）。high にすると品質が上がる代わりに時間と料金が増える
ANTHROPIC_EFFORT=
# claude: Claude を使う / mock: AI を呼ばず決まった例文を返す。空なら APIキーがあれば claude、なければ mock
AI_PROVIDER_MODE=
# ===== 画像・動画生成（fal.ai） =====
FAL_KEY=
# 使うモデル（空なら画像 fal-ai/flux-1/schnell、動画 fal-ai/kling-video/v2.5-turbo/pro/text-to-video）
FAL_IMAGE_MODEL=
FAL_VIDEO_MODEL=
# fal: fal.ai で生成 / mock: 仮の画像を返す。空なら FAL_KEY があれば fal、なければ mock
MEDIA_PROVIDER_MODE=

# ===== テスト =====
# 設定すると DB を使う統合テストが実行される（未設定ならスキップ）。開発用DBとは別にすること
TEST_DATABASE_URL=

# 新規登録できるメールアドレス（カンマ区切り）。未設定なら誰でも登録できる。
# 公開URLで動かすときは必ず設定する（他人に AI・画像生成の APIキーを使われないようにするため）
ALLOWED_EMAILS=

# TikTok（TikTok for Developers のアプリの Client key / Client secret。「TikTokでログインして連携」に使う）
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# 投稿の公開範囲。TikTok の審査に通るまでは SELF_ONLY（自分だけに表示）のみ。審査後は PUBLIC_TO_EVERYONE
TIKTOK_PRIVACY_LEVEL=SELF_ONLY

# 利用規約・プライバシーポリシー（/terms・/privacy）に表示する運営者名と連絡先
LEGAL_OPERATOR_NAME=
LEGAL_CONTACT_EMAIL=
