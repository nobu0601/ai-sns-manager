# ===== 基本 =====
# PostgreSQL 接続文字列
DATABASE_URL=postgresql://sns:sns@localhost:5432/ai_sns_manager
# Redis 接続文字列（BullMQ のジョブキュー）
REDIS_URL=redis://localhost:6379

# Auth.js のセッション署名キー（生成: openssl rand -base64 32）
AUTH_SECRET=
# ローカル以外で動かす場合のみ設定（例: https://example.com）
AUTH_URL=http://localhost:3000
# リバースプロキシ配下（Render等）で動かす場合は true
AUTH_TRUST_HOST=true

# OAuth トークン暗号化キー。32バイトを base64 で（生成: openssl rand -base64 32）
ENCRYPTION_KEY=

# ===== SNS =====
# mock: 実際のSNS APIを呼ばない / live: 公式APIを呼ぶ（Step 11以降で実装）
SOCIAL_PROVIDER_MODE=mock
# Mock Mode で投稿が確率的に一時失敗する割合（0〜1）。リトライ動作の確認用
MOCK_TRANSIENT_FAILURE_RATE=0

X_CLIENT_ID=
X_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
THREADS_CLIENT_ID=
THREADS_CLIENT_SECRET=

# ===== AI / Media（Phase 2 以降） =====
OPENAI_API_KEY=
FAL_KEY=

# ===== テスト =====
# 設定すると DB を使う統合テストが実行される（未設定ならスキップ）。開発用DBとは別にすること
TEST_DATABASE_URL=
