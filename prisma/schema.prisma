// AI SNS Manager データベーススキーマ
// 詳細は docs/database.md を参照

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Platform {
  X
  INSTAGRAM
  THREADS
}

// 投稿全体の状態（SNS別の状態から集計される）
enum PostStatus {
  DRAFT
  GENERATING
  READY
  SCHEDULED
  POSTING
  PUBLISHED
  FAILED
  CANCELLED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  NOT_REQUIRED
}

// SNS別の投稿状態
enum PostPlatformStatus {
  DRAFT
  SCHEDULED
  POSTING
  PUBLISHED
  FAILED
  CANCELLED
}

enum ApprovalMode {
  ALWAYS // 常に承認
  AI_ONLY // AI生成後のみ承認
  AUTO // 完全自動
}

enum SocialAccountStatus {
  CONNECTED
  EXPIRED
  DISCONNECTED
}

enum PostLogEvent {
  POST_CREATED
  POST_UPDATED
  AI_GENERATED
  APPROVED
  REJECTED
  SCHEDULED
  CANCELLED
  POST_STARTED
  POST_SUCCESS
  POST_FAILED
  RETRY
}

enum MediaType {
  IMAGE
  VIDEO
}

enum MediaProvider {
  FAL_AI
  MOCK
}

enum MediaStatus {
  PENDING
  GENERATING
  READY
  FAILED
}

enum AgentRunTrigger {
  MANUAL
  SCHEDULED
}

enum AgentRunStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

enum LogStatus {
  INFO
  SUCCESS
  WARNING
  ERROR
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String?
  // bcrypt ハッシュ。平文パスワードは保存しない
  passwordHash String
  approvalMode ApprovalMode @default(ALWAYS)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  brands          Brand[]
  socialAccounts  SocialAccount[]
  posts           Post[]
  media           Media[]
  agentConfigs    AgentConfig[]
  agentRuns       AgentRun[]
  analysisReports AnalysisReport[]
}

model Brand {
  id               String   @id @default(cuid())
  userId           String
  name             String
  description      String   @default("")
  targetAudience   String   @default("")
  brandImage       String   @default("")
  tone             String   @default("")
  objective        String   @default("")
  avoidExpressions String   @default("")
  keywords         String[] @default([])
  prohibitedWords  String[] @default([])
  contentPillars   String[] @default([])
  // 開発用サンプル（seed で作成）。本番データと区別する
  isSample         Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  posts           Post[]
  socialAccounts  SocialAccount[]
  agentConfig     AgentConfig?
  agentRuns       AgentRun[]
  analysisReports AnalysisReport[]

  @@index([userId])
}

// SNSアカウント。ユーザーが入力したAPIキー・アクセストークンで連携する。
// SNSのログインパスワードは保存しない。キー一式は暗号化したJSONとして保存し、画面・APIには返さない
model SocialAccount {
  id                   String              @id @default(cuid())
  userId               String
  brandId              String?
  platform             Platform
  // SNS上の表示名（@handle など）。キー確認時にAPIから取得する
  accountName          String
  externalAccountId    String
  // 利用者が付ける管理用の名前（任意）
  label                String              @default("")
  credentialsEncrypted String
  // 画面表示用のキー末尾4文字（例: "••••abcd"）
  credentialHint       String              @default("")
  tokenExpiresAt       DateTime?
  status               SocialAccountStatus @default(CONNECTED)
  isMock               Boolean             @default(false)
  lastCheckedAt        DateTime?
  // 直近のキー確認・投稿で起きたエラー（ユーザー向けの文）
  lastError            String?
  // 分析の数値取得の結果（取得できないときのユーザー向けの文。例：X のプランでは取得できない）
  metricsError         String?
  metricsCheckedAt     DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  brand          Brand?          @relation(fields: [brandId], references: [id], onDelete: SetNull)
  postPlatforms  PostPlatform[]
  accountMetrics AccountMetric[]
  externalPosts  ExternalPost[]

  @@unique([userId, platform, externalAccountId])
  @@index([userId, platform])
}

model Post {
  id             String         @id @default(cuid())
  userId         String
  brandId        String?
  title          String
  topic          String         @default("")
  status         PostStatus     @default(DRAFT)
  approvalStatus ApprovalStatus @default(PENDING)
  scheduledAt    DateTime?
  // AI が作った案を採用した投稿か（承認モード「AI生成後のみ承認」の判定とログに使う）
  aiGenerated    Boolean        @default(false)
  // AI Agent が作った投稿の場合、その実行と、割り当てた投稿テーマの柱
  agentRunId     String?
  contentPillar  String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  brand     Brand?         @relation(fields: [brandId], references: [id], onDelete: SetNull)
  agentRun  AgentRun?      @relation(fields: [agentRunId], references: [id], onDelete: SetNull)
  platforms PostPlatform[]
  media     Media[]

  @@index([userId, status])
  @@index([userId, scheduledAt])
}

// 投稿先（1つのSNSアカウント）ごとの投稿内容と結果
model PostPlatform {
  id              String             @id @default(cuid())
  postId          String
  platform        Platform
  // 投稿先アカウント。アカウントを切断しても履歴は残す（null になる）
  socialAccountId String?
  // 投稿時点のアカウント名（切断後も履歴で表示するため）
  accountName     String             @default("")
  content         String
  // 添付する画像・動画のURL（Instagram は必須）と、その種類
  mediaUrls       String[]           @default([])
  mediaType       MediaType?
  status          PostPlatformStatus @default(DRAFT)
  // 二重投稿防止キー（postId:socialAccountId）
  idempotencyKey  String             @unique
  attempts        Int                @default(0)
  publishedAt     DateTime?
  externalPostId  String?
  externalUrl     String?
  // ユーザー向けの分かりやすいエラー文。技術的な詳細は PostLog.metadata に残す
  errorMessage    String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  post          Post           @relation(fields: [postId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount? @relation(fields: [socialAccountId], references: [id], onDelete: SetNull)
  logs          PostLog[]
  metric        PostMetric?

  @@unique([postId, socialAccountId])
  @@index([status])
}

model PostLog {
  id             String       @id @default(cuid())
  postPlatformId String
  event          PostLogEvent
  status         LogStatus
  message        String
  metadata       Json?
  createdAt      DateTime     @default(now())

  postPlatform PostPlatform @relation(fields: [postPlatformId], references: [id], onDelete: Cascade)

  @@index([postPlatformId, createdAt])
}

// 生成した画像・動画（fal.ai などで作成）。URL は生成サービスの公開URLをそのまま使う
model Media {
  id           String        @id @default(cuid())
  userId       String
  postId       String?
  type         MediaType
  provider     MediaProvider
  // ユーザーが入力したイメージ（日本語）と、AI が作った生成用プロンプト
  idea         String
  prompt       String        @default("")
  // 動画の構成（場面ごとの説明）。画像では空
  script       String        @default("")
  aspectRatio  String        @default("1:1")
  model        String        @default("")
  url          String?
  status       MediaStatus   @default(PENDING)
  errorMessage String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post? @relation(fields: [postId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

// ブランドごとの AI Agent 設定（投稿頻度・曜日・時間帯・毎週の自動実行）
model AgentConfig {
  id                String   @id @default(cuid())
  userId            String
  brandId           String   @unique
  // 毎週の自動実行
  weeklyEnabled     Boolean  @default(false)
  runWeekday        Int      @default(1) // 0=日 … 6=土（日本時間）
  runTime           String   @default("09:00")
  // 投稿の計画
  postsPerWeek      Int      @default(3)
  preferredWeekdays Int[]    @default([1, 3, 5])
  preferredTime     String   @default("12:00")
  targetAccountIds  String[] @default([])
  generateImages    Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)
}

// AI Agent の実行記録
model AgentRun {
  id           String          @id @default(cuid())
  userId       String
  brandId      String
  trigger      AgentRunTrigger
  status       AgentRunStatus  @default(QUEUED)
  // 計画の対象期間
  periodStart  DateTime?
  periodEnd    DateTime?
  // AI が決めた計画（テーマ・型・理由）と、結果の説明
  plan         Json?
  summary      String?
  errorMessage String?
  createdAt    DateTime        @default(now())
  finishedAt   DateTime?

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  brand Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)
  posts Post[]

  @@index([userId, createdAt])
}

// 投稿ごとの成績（SNS から取得した最新の値）。SNS が返さない指標は null（0 と区別する）
model PostMetric {
  id             String   @id @default(cuid())
  postPlatformId String   @unique
  platform       Platform
  // 表示回数（X: impression_count / Threads・Instagram: views）
  views          Int?
  // リーチ（Instagram のみ）
  reach          Int?
  likes          Int?
  // コメント・返信
  comments       Int?
  // シェア・リポスト・引用の合計
  shares         Int?
  // 保存・ブックマーク
  saves          Int?
  // リンクのクリック（取得できる SNS がない間は null）
  clicks         Int?
  // SNS API の数値（項目名は SNS のまま。詳細確認用）
  raw            Json?
  fetchedAt      DateTime @default(now())
  createdAt      DateTime @default(now())

  postPlatform PostPlatform @relation(fields: [postPlatformId], references: [id], onDelete: Cascade)
}

// アカウントのフォロワー数（日本時間の1日に1件）
model AccountMetric {
  id              String   @id @default(cuid())
  socialAccountId String
  // 日本時間のその日の 0:00
  date            DateTime
  followers       Int
  fetchedAt       DateTime @default(now())

  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@unique([socialAccountId, date])
}

// AI による分析の結果。根拠となる投稿の数値（evidence）も一緒に保存し、画面で並べて表示する
model AnalysisReport {
  id           String          @id @default(cuid())
  userId       String
  brandId      String
  trigger      AgentRunTrigger
  status       AgentRunStatus  @default(QUEUED)
  periodStart  DateTime?
  periodEnd    DateTime?
  postCount    Int             @default(0)
  // AI の分析（反応が良かったテーマ・文章傾向・投稿時間傾向・次回投稿案）
  result       Json?
  // AI に渡した実績データ（投稿ごとの数値と集計）
  evidence     Json?
  model        String          @default("")
  errorMessage String?
  createdAt    DateTime        @default(now())
  finishedAt   DateTime?

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([userId, brandId, createdAt])
}

// SNS から読み込んだ、そのアカウントの過去の投稿（このアプリ以外から投稿したものを含む）。
// AI が過去の投稿と内容を重ねないため・流れを踏まえるために使う。このアプリから投稿したものは PostPlatform にあるため保存しない
model ExternalPost {
  id              String   @id @default(cuid())
  socialAccountId String
  platform        Platform
  externalPostId  String
  text            String
  permalink       String?
  publishedAt     DateTime
  fetchedAt       DateTime @default(now())

  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@unique([socialAccountId, externalPostId])
  @@index([socialAccountId, publishedAt])
}
