// AI SNS Manager データベーススキーマ
// 詳細は docs/database.md を参照

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Platform {
  X
  INSTAGRAM
  THREADS
}

// 投稿全体の状態（SNS別の状態から集計される）
enum PostStatus {
  DRAFT
  GENERATING
  READY
  SCHEDULED
  POSTING
  PUBLISHED
  FAILED
  CANCELLED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  NOT_REQUIRED
}

// SNS別の投稿状態
enum PostPlatformStatus {
  DRAFT
  SCHEDULED
  POSTING
  PUBLISHED
  FAILED
  CANCELLED
}

enum ApprovalMode {
  ALWAYS // 常に承認
  AI_ONLY // AI生成後のみ承認
  AUTO // 完全自動
}

enum SocialAccountStatus {
  CONNECTED
  EXPIRED
  DISCONNECTED
}

enum PostLogEvent {
  POST_CREATED
  POST_UPDATED
  AI_GENERATED
  APPROVED
  REJECTED
  SCHEDULED
  CANCELLED
  POST_STARTED
  POST_SUCCESS
  POST_FAILED
  RETRY
}

enum LogStatus {
  INFO
  SUCCESS
  WARNING
  ERROR
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String?
  // bcrypt ハッシュ。平文パスワードは保存しない
  passwordHash String
  approvalMode ApprovalMode @default(ALWAYS)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  brands         Brand[]
  socialAccounts SocialAccount[]
  posts          Post[]
}

model Brand {
  id               String   @id @default(cuid())
  userId           String
  name             String
  description      String   @default("")
  targetAudience   String   @default("")
  brandImage       String   @default("")
  tone             String   @default("")
  objective        String   @default("")
  avoidExpressions String   @default("")
  keywords         String[] @default([])
  prohibitedWords  String[] @default([])
  contentPillars   String[] @default([])
  // 開発用サンプル（seed で作成）。本番データと区別する
  isSample         Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  posts          Post[]
  socialAccounts SocialAccount[]

  @@index([userId])
}

// SNSアカウント。ユーザーが入力したAPIキー・アクセストークンで連携する。
// SNSのログインパスワードは保存しない。キー一式は暗号化したJSONとして保存し、画面・APIには返さない
model SocialAccount {
  id                   String              @id @default(cuid())
  userId               String
  brandId              String?
  platform             Platform
  // SNS上の表示名（@handle など）。キー確認時にAPIから取得する
  accountName          String
  externalAccountId    String
  // 利用者が付ける管理用の名前（任意）
  label                String              @default("")
  credentialsEncrypted String
  // 画面表示用のキー末尾4文字（例: "••••abcd"）
  credentialHint       String              @default("")
  tokenExpiresAt       DateTime?
  status               SocialAccountStatus @default(CONNECTED)
  isMock               Boolean             @default(false)
  lastCheckedAt        DateTime?
  // 直近のキー確認・投稿で起きたエラー（ユーザー向けの文）
  lastError            String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  brand         Brand?         @relation(fields: [brandId], references: [id], onDelete: SetNull)
  postPlatforms PostPlatform[]

  @@unique([userId, platform, externalAccountId])
  @@index([userId, platform])
}

model Post {
  id             String         @id @default(cuid())
  userId         String
  brandId        String?
  title          String
  topic          String         @default("")
  status         PostStatus     @default(DRAFT)
  approvalStatus ApprovalStatus @default(PENDING)
  scheduledAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  brand     Brand?         @relation(fields: [brandId], references: [id], onDelete: SetNull)
  platforms PostPlatform[]

  @@index([userId, status])
  @@index([userId, scheduledAt])
}

// 投稿先（1つのSNSアカウント）ごとの投稿内容と結果
model PostPlatform {
  id              String             @id @default(cuid())
  postId          String
  platform        Platform
  // 投稿先アカウント。アカウントを切断しても履歴は残す（null になる）
  socialAccountId String?
  // 投稿時点のアカウント名（切断後も履歴で表示するため）
  accountName     String             @default("")
  content         String
  // 添付する画像のURL（Instagram は必須）
  mediaUrls       String[]           @default([])
  status          PostPlatformStatus @default(DRAFT)
  // 二重投稿防止キー（postId:socialAccountId）
  idempotencyKey  String             @unique
  attempts        Int                @default(0)
  publishedAt     DateTime?
  externalPostId  String?
  externalUrl     String?
  // ユーザー向けの分かりやすいエラー文。技術的な詳細は PostLog.metadata に残す
  errorMessage    String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  post          Post           @relation(fields: [postId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount? @relation(fields: [socialAccountId], references: [id], onDelete: SetNull)
  logs          PostLog[]

  @@unique([postId, socialAccountId])
  @@index([status])
}

model PostLog {
  id             String       @id @default(cuid())
  postPlatformId String
  event          PostLogEvent
  status         LogStatus
  message        String
  metadata       Json?
  createdAt      DateTime     @default(now())

  postPlatform PostPlatform @relation(fields: [postPlatformId], references: [id], onDelete: Cascade)

  @@index([postPlatformId, createdAt])
}
